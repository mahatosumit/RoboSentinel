# RoboSentinel needs no API keys or secrets.
# Optional process environment values; server.js does not load .env files.
# Set these in your shell, or copy to .env and run: node --env-file=.env server.js
# Docker supplies HOST=0.0.0.0 internally; do not override it with native loopback.
HOST=127.0.0.1
PORT=3000
